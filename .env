# 服务器配置
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 数据库配置
DATABASE_PATH=./database/photos.db

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# 文件上传配置
UPLOAD_DIR=./uploads
PHOTOS_DIR=./photos
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif

# 图片处理配置
IMAGE_QUALITY=85
THUMBNAIL_SIZE=300
MEDIUM_SIZE=800
LARGE_SIZE=1920

# 安全配置
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME=900000

# 应用配置
APP_NAME=我们的小宇宙
APP_VERSION=2.0.0
DEFAULT_START_DATE=2024-01-01

# 密码验证配置（可通过管理界面修改）
CORRECT_MONTH=1
CORRECT_NICKNAME=宝贝
CORRECT_WORD=宇宙