# 服务器配置
PORT=3000
NODE_ENV=development

# JWT配置
JWT_SECRET=our-little-universe-secret-2024-please-change-this-in-production
JWT_EXPIRES=7d
REFRESH_TOKEN_EXPIRES=30d

# 数据库配置
DB_PATH=./database/photos.db

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
PHOTO_DIR=./photos

# 允许的跨域源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# 安全问题答案（生产环境中应该存储在数据库中）
SECURITY_MONTH=1
SECURITY_NICKNAME=宝宝
SECURITY_WORD=宇宙

# 调试配置
DEBUG_ENABLED=true
LOG_LEVEL=info

# 性能配置
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_AUTO_OPTIMIZATION=true